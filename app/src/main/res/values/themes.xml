<resources>
    <!-- Phone setup screen -->
    <style name="Theme.OpenDash" parent="Theme.Material3.DayNight" />

    <!-- Car screen (rendered onto the Android Auto surface) -->
    <style name="Theme.OpenDash.Car" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/car_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="RailButton">
        <item name="android:layout_width">54dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/rail_button_bg</item>
        <item name="android:padding">15dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/car_text</item>
    </style>
</resources>
